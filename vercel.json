{
  "version": 2,
  "builds": [
    {
      "src": "*.php",
      "use": "@vercel/php"
    },
    {
      "src": "api/*.php",
      "use": "@vercel/php"
    },
    {
      "src": "api/Proses/*.php",
      "use": "@vercel/php"
    }
  ],
  "routes": [
    {
      "src": "/api/Proses/(.*)\\.php",
      "dest": "/api/Proses/$1.php"
    },
    {
      "src": "/api/(.*)\\.php",
      "dest": "/api/$1.php"
    },
    {
      "src": "/",
      "dest": "/index.html"
    }
  ]
}